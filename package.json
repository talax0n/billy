{
  "name": "billy",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=!@billy/desktop",
    "dev:legacy": "PGLITE_DIR=$PWD/.data/legacy turbo run dev --filter=!@billy/desktop",
    "dev:prod": "DATABASE_URL=postgresql://localhost/billy_prod turbo run dev --filter=!@billy/desktop",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @billy/e2e e2e"
  },
  "devDependencies": {
    "turbo": "^2.11.11",
    "typescript": "^7.0.2"
  }
}
